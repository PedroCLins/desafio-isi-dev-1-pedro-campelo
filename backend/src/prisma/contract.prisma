// use prisma-8
enum Position {
  GOL
  ZAG
  LAT
  MEI
  ATA
}

enum Condition {
  APTO
  MAL_CONDICIONADO
  DOENTE
}

enum Formation {
  FORMATION_3_1 = "3-1"
  FORMATION_2_2 = "2-2"
  FORMATION_2_1_1 = "2-1-1"
  FORMATION_1_2_1 = "1-2-1"
}

enum ContractStatus {
  ATIVO
  ENCERRADO
  RESCINDIDO
}

enum TransactionType {
  COMPRA
  VENDA
}

enum Attribute {
  shooting
  passing
  dribbling
  defending
}

model Players {
  id         Int                  @id @default(autoincrement())
  name       String
  position   Position
  agility    Int
  age        Int
  base_value Decimal
  condition  Condition

  club_id    Int?
  club       Clubs?               @relation(fields: [club_id], references: [id])

  pace       Int
  shooting   Int
  passing    Int
  dribbling  Int
  defending  Int
  physical   Int
  potential  Int

  deleted_at TimestamptzString()?
  created_at TimestamptzString()  @default(now())
  updated_at temporal.updatedAt()
}

model Clubs {
  id         Int                 @id @default(autoincrement())
  name       String              @unique
  acronym    String              @unique
  cash       Decimal             @default(300.00)
  formation  Formation?
  created_at TimestamptzString() @default(now())
  players    Players[]
}

model Contracts {
  id              Int                  @id @default(autoincrement())
  club_id         Int
  club            Clubs                @relation(fields: [club_id], references: [id])
  player_id       Int
  player          Players              @relation(fields: [player_id], references: [id])

  purchase_value  Decimal
  status          ContractStatus
  loyalty_until   TimestamptzString()
  created_at      TimestamptzString()  @default(now())
  ended_at        TimestamptzString()?
}

model Transactions {
  id          Int                 @id @default(autoincrement())
  club_id     Int
  club        Clubs               @relation(fields: [club_id], references: [id])
  player_id   Int
  player      Players             @relation(fields: [player_id], references: [id])

  player_name String
  type        TransactionType
  value       Decimal
  fee         Decimal
  penalty     Decimal
  profit      Decimal?
  cash_change Decimal
  created_at  TimestamptzString() @default(now())
}

model Lineups {
  club_id    Int
  club       Clubs               @relation(fields: [club_id], references: [id])
  player_id  Int
  player     Players             @relation(fields: [player_id], references: [id])
  created_at TimestamptzString() @default(now())
}

model Matches {
  id                  Int                 @id @default(autoincrement())
  home_club_id        Int
  home_club           Clubs               @relation("Home Club", fields: [home_club_id], references: [id])
  away_club_id        Int
  away_club           Clubs               @relation("Away Club", fields: [away_club_id], references: [id])

  home_club_goals     Int
  away_club_goals     Int
  home_club_formation Formation
  away_club_formation Formation
  played_at           TimestamptzString() @default(now())
}

model MatchDuels {
  id                 Int       @id @default(autoincrement())
  match_id           Int
  match              Matches   @relation(fields: [match_id], references: [id])
  order              Int
  attacking_club_id  Int
  attacking_club     Clubs     @relation("Attacking Club", fields: [attacking_club_id], references: [id])

  attacker_id        Int
  attacker           Players   @relation("Attacking Player", fields: [attacker_id], references: [id])
  attacker_name      String
  attacker_position  Position
  attacker_condition Condition
  attack_attribute   Attribute
  attack_value       Int

  defender_id        Int
  defender           Players   @relation("Defending Player", fields: [defender_id], references: [id])
  defender_name      String
  defender_position  Position
  defender_condition Condition
  defense_attribute  Attribute
  defense_value      Int

  goal               Boolean
}
