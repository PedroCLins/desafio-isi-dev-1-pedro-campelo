// use prisma-8
enum Posicao {
  GOL
  ZAG
  LAT
  MEI
  ATA
}

enum Condicao {
  APTO
  MAL_CONDICIONADO
  DOENTE
}

model Jogador {
  id         Int       @id @default(autoincrement())
  name       String
  position   Posicao
  agility    Int
  age        Int
  base_value Decimal

  pace       Int
  shooting   Int
  passing    Int
  dribbling  Int
  defending  Int
  physical   Int

  potential  Int
  overall    Int
  condition  Condicao
  club_id    Int
  club       Clube      @relation(fields: [club_id], references: [id])
}

model Clube {
  id      Int      @id @default(autoincrement())
  name    String
  acronym String
  cash    Decimal
  players Jogador[]
}

model Purchase {
  id       Int      @id @default(autoincrement())
  club_id   Int
  club      Clube     @relation(fields: [club_id], references: [id])
  player_id Int
  player    Jogador   @relation(fields: [player_id], references: [id])
  loyalty_until TimestamptzString()
}

enum TipoTransacao {
  COMPRA
  VENDA
}

model HistoricoTransacao {
  id          Int      @id @default(autoincrement())
  club_id     Int
  club        Clube     @relation(fields: [club_id], references: [id])
  player_id   Int
  player      Jogador   @relation(fields: [player_id], references: [id])
  type        TipoTransacao
  value       Decimal
  fee         Decimal
  penalty     Decimal
  profit      Decimal
  cash_change Decimal
  created_at  TimestamptzString() @default(now())
}
